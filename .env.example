# DeepSeek API key — required for live calls
DEEPSEEK_API_KEY=sk-...

# Optional overrides
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# Harness bridge — hosts the DeepSeek model may drive, and their headless commands.
# Empty HARNESS_ALLOW_HOSTS = bridge locked.
# HARNESS_ALLOW_HOSTS=claude,codex,opencode
# HARNESS_CMD_CLAUDE=claude -p
# HARNESS_CMD_CODEX=codex exec --skip-git-repo-check
# HARNESS_CMD_OPENCODE=script -q /dev/null opencode run
